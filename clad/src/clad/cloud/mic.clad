#include "clad/cloud/common.clad"

namespace Anki {
namespace Vector {
namespace CloudMic {

enum uint_8 StreamType {
	Normal,
	Blackjack,
	KnowledgeGraph
}

enum uint_8 ErrorType {
	Server,
	Timeout,
	Json,
	InvalidConfig,
	Connecting,
	NewStream,
	Token,
	TLS, // only used by connection check
	Connectivity
}

// Note: Keep this enum in sync with the version in robot/clad/src/clad/robotInterface/messageFromAnimProcess.clad
enum uint_8 ConnectionCode {
	Available,
	Connectivity,
	Tls,
	Auth,
	Bandwidth
}

structure StreamOpen {
	string session
}

structure Hotword {
	StreamType mode,
	string locale,
	string timezone,
	bool noLogging,
}

structure Filename {
	string file
}

structure AudioData {
	int_16 data[uint_16]
}

// Response-audio lifecycle (cloud -> engine). Used to stream cloud-generated
// answer speech (e.g. Knowledge Graph) as chunked PCM instead of embedding it
// in IntentResult parameters. See docs/development/knowledge_graph_cloud_audio_implementation_design.md
enum uint_8 ResponseAudioEncoding {
	Pcm16Le,
	Opus
}

enum uint_8 ResponseAudioErrorType {
	Provider,
	InvalidFormat,
	TooLarge,
	Timeout,
	Cancelled,
	Transport
}

structure ResponseAudioStart {
	string responseId,
	ResponseAudioEncoding encoding,
	uint_32 sampleRateHz,
	uint_8 channels,
	uint_32 totalFrames,
	bool totalFramesKnown
}

// data payload must be capped at 1024 bytes by the sender so the packed
// message stays below the 4096-byte engine receive buffer.
structure ResponseAudioChunk {
	string responseId,
	uint_32 sequenceNumber,
	uint_8 data[uint_16]
}

structure ResponseAudioEnd {
	string responseId,
	uint_32 finalSequenceNumber
}

structure ResponseAudioError {
	string responseId,
	ResponseAudioErrorType error,
	string details
}

structure IntentResult {
	string intent,
	string[uint_16] parameters,
	string[uint_16] metadata
}

structure IntentError {
	ErrorType error,
	string extra
}

structure ConnectionResult {
	ConnectionCode code,
	string status,
	uint_8 numPackets,
	uint_8 expectedPackets,
}

union dupes_allowed Message {
	// anim -> cloud
	Hotword hotword,
	AudioData audio,
	Void audioDone,
	Void connectionCheck,

	// cloud -> anim
	Void stopSignal,
	Void testStarted,
	Void streamTimeout,
	ConnectionResult connectionResult,

	// cloud -> engine
	Filename debugFile,
	IntentResult result,
	IntentError error,
	StreamOpen streamOpen,

	// cloud -> engine: response-audio lifecycle
	ResponseAudioStart responseAudioStart,
	ResponseAudioChunk responseAudioChunk,
	ResponseAudioEnd responseAudioEnd,
	ResponseAudioError responseAudioError
}


}
}
}
